---
layout: default
---
{% assign recent_news = site.news | sort: 'date' | reverse | first %}
{% assign ai_post = site.posts | where: 'title', 'Economic Research in the Era of AI' | first %}

<div class="minimal-home">
  <section class="home-identity" aria-label="Homepage navigation">
    <h1>Ling Zheng</h1>
    <p class="home-hand-note" aria-label="I'm an economics master's student working across theory and empirical research.">
      <span>I’m</span><span>an economics</span><span>master’s student</span><span>working</span><span>across</span><span>theory</span
      ><span>and empirical research.</span>
    </p>

    <nav class="home-nav" aria-label="Primary navigation">
      <a class="home-nav-about" href="{{ '/' | relative_url }}" aria-current="page">About</a>
      <a class="home-nav-research" href="{{ '/publications/' | relative_url }}">Research</a>
      <a class="home-nav-blog" href="{{ '/blog/' | relative_url }}">Blog</a>
      <a class="home-nav-goods" href="{{ '/public-goods/' | relative_url }}">Public Goods</a>
      <a class="home-nav-cv" href="{{ '/cv/' | relative_url }}">CV</a>
    </nav>
  </section>

  <div class="home-tools">
    <p class="home-edition" aria-hidden="true">Academic homepage · {{ site.time | date: '%Y' }}</p>
    {% if site.enable_darkmode %}
      <button id="light-toggle" class="home-theme-toggle" title="Change theme" aria-label="Change color theme">
        <i class="fa-half-sun-moon" id="light-toggle-system"></i>
        <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
        <i class="fa-solid fa-sun" id="light-toggle-light"></i>
      </button>
    {% endif %}
  </div>

  <div class="home-character">
    <aside
      class="home-speech"
      data-ai-url="{% if ai_post %}{{ ai_post.url | relative_url }}{% endif %}"
      data-research-url="{{ '/publications/' | relative_url }}"
      role="status"
      aria-live="polite"
      hidden
    ></aside>
    <figure class="home-portrait">
      <img src="{{ '/assets/img/portrait-cutout.png' | relative_url }}" alt="Illustrated portrait of Ling Zheng" width="1254" height="1254">
    </figure>
  </div>

  <section class="home-lower" aria-label="News and links">
    <div class="home-news">
      <p class="home-label">News</p>
      {% if recent_news %}
        <div class="home-news-line">
          <time datetime="{{ recent_news.date | date: '%Y-%m-%d' }}">{{ recent_news.date | date: '%Y.%m.%d' }}</time>
          <span>{{ recent_news.content | strip_html | strip_newlines }}</span>
        </div>
      {% endif %}
    </div>

    <div class="home-links">
      <p class="home-label">Links</p>
      <div class="home-link-row">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <a href="{{ site.data.socials.X.url }}" target="_blank" rel="noopener noreferrer">X</a>
        <a href="{{ site.data.socials.ig.url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a
          href="https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=Mzg3Mzg2NDYzNQ==#wechat_redirect"
          target="_blank"
          rel="noopener noreferrer"
          >WeChat</a
        >
      </div>
    </div>
  </section>
</div>
